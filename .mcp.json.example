{
  "mcpServers": {
    "qs-registry": {
      "command": "D:/PythonEnv/QS312/Scripts/python.exe",
      "args": ["D:/HST/QSExt/mcp/qs_registry.py"],
      "env": {
        "PYTHONPATH": "D:/Project/QuantStudio;D:/HST/QSExt",
        "OLLAMA_BASE_URL": "http://127.0.0.1:11434",
        "OLLAMA_API_KEY": "ollama",
        "EMBEDDING_MODEL": "bge-m3",
        "QS_TOOLS": "all"
      }
    },
    "qswiki": {
      "command": "D:/PythonEnv/QS312/Scripts/python.exe",
      "args": ["-m", "kb_query_mcp.server"],
      "cwd": "D:/HST/QSWiki",
      "env": {
        "PYTHONPATH": "D:/HST/QSWiki/mcp/src",
        "KB_ROOT": "D:/HST/QSWiki/knowledge-base"
      }
    },
    "jy_base_doc": {
      "command": "D:/PythonEnv/QS312/Scripts/python.exe",
      "args": [
        "D:/Project/QSAgent/mcp/jy_base_doc_pg.py",
        "--env",
        "PYTHONPATH=D:/Project/QuantStudio;D:/HST/QSExt;D:/Project/QSAgent"
      ]
    }
  }
}