# QSWeb 后端配置示例
# 复制此文件为 .env 并修改配置

# 应用配置
APP_NAME=QSWeb
APP_VERSION=0.1.0
DEBUG=true

# CORS 配置（逗号分隔）
CORS_ORIGINS=http://localhost:23000,http://127.0.0.1:23000

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0

# PostgreSQL 配置（可选）
DATABASE_URL=postgresql://user:pass@localhost:5432/qsweb

# QuantStudio 配置路径
QS_CONFIG_PATH=~/QuantStudioConfig
