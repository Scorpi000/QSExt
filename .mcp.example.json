{
  "mcpServers": {
    "qs_registry": {
      "command": "{{PYTHON}}",
      "args": [
        "{{QS_REGISTRY_PY}}"
      ],
      "cwd": "{{PROJECT}}",
      "env": {
        "PYTHONPATH": "{{PYTHONPATH}}",
        "OLLAMA_BASE_URL": "{{OLLAMA_BASE_URL}}",
        "OLLAMA_API_KEY": "{{OLLAMA_API_KEY}}",
        "EMBEDDING_MODEL": "{{EMBEDDING_MODEL}}",
        "QS_TOOLS": "{{QS_TOOLS}}"
      }
    },
    "tinysoft_doc": {
      "command": "{{PYTHON}}",
      "args": [
        "{{TINYSOFT_DOC_PY}}",
        "--cache-dir",
        "{{TINYSOFT_CACHE_DIR}}"
      ],
      "cwd": "{{PROJECT}}",
      "env": {
        "PYTHONPATH": "{{PYTHONPATH}}"
      }
    },
    "akshare_doc": {
      "command": "{{PYTHON}}",
      "args": [
        "{{AKSHARE_DOC_PY}}",
        "--cache-dir",
        "{{AKSHARE_CACHE_DIR}}"
      ],
      "cwd": "{{PROJECT}}",
      "env": {
        "PYTHONPATH": "{{PYTHONPATH}}"
      }
    }
  }
}
